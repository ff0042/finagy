# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Default Workstation LLM Model (Best value: google/gemini-2.5-flash)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: Strategic Financial Advisor Model (e.g. deepseek/deepseek-r1 or google/gemini-3.1-pro-preview)
OPENROUTER_STRATEGIC_MODEL=deepseek/deepseek-r1

# ==============================================================================
# OpenRouter Model Selection Guide
# ==============================================================================
# Category / Role            | OpenRouter Model ID               | Cost / 1M (Prompt/Comp) | Best For & When to Use
# ---------------------------|-----------------------------------|-------------------------|---------------------------------------------------------
# Free Deterministic Engine  | mock/deterministic                | FREE                    | Zero-cost basic mechanical trades & watchlist commands
# Default Workstation (Best) | google/gemini-2.5-flash           | ~$0.30 / ~$1.20         | Best overall value for mechanical trades ("buy 10 shares") & chat
# Strategic Advisor (Math)   | deepseek/deepseek-r1              | ~$0.70 / ~$2.50         | Options strategies (iron condors), Sharpe ratio & risk math
# Frontier Reasoning         | google/gemini-3.1-pro-preview     | ~$2.00 / ~$6.00         | Long context macro synthesis & complex portfolio strategy
# Premium Qualitative        | anthropic/claude-3.7-sonnet       | ~$3.00 / ~$15.00        | Executive financial reports & detailed written analysis
# Ultra-Budget Mechanical    | google/gemini-2.5-flash-lite      | ~$0.10 / ~$0.40         | High-volume simple trade & watchlist commands
# ==============================================================================

# Optional: Set to "false" to use real LLM and Schwab Market Data provider (when configured)
# Set to "true" for deterministic mock LLM responses
LLM_MOCK=false

# Schwab Developer API Credentials (Used when LLM_MOCK=false)
SCHWAB_CLIENT_ID=your-schwab-client-id-here
SCHWAB_CLIENT_SECRET=your-schwab-client-secret-here
SCHWAB_REDIRECT_URI=https://127.0.0.1:8080
SCHWAB_TOKENS_FILE=db/tokens.json

# Optional: Massive (Polygon.io) API key for alternative real market data
MASSIVE_API_KEY=
